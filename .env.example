# ─────────────────────────────────────────────────────────────────────────────
# ITSM Cloud-Native Demo App — Environment Variables Template
# Copy this file to .env and fill in real values.
# .env is git-ignored — NEVER commit the actual .env file.
# ─────────────────────────────────────────────────────────────────────────────

# ── Environment ──────────────────────────────────────────────────────────────
# dev | qa
ENV=dev

# ── PostgreSQL (external standalone instance) ────────────────────────────────
# Replace <machine-ip> with the actual IP of your PostgreSQL host machine.
# This single variable is used by all services, scripts, and golang-migrate.
DATABASE_URL=postgres://itsm:itsm@<machine-ip>:5432/itsm?sslmode=disable

# ── Redis ─────────────────────────────────────────────────────────────────────
# Replace <machine-ip> with the Redis host.
REDIS_URL=redis://<machine-ip>:6379/0

# ── RabbitMQ ─────────────────────────────────────────────────────────────────
RABBITMQ_URL=amqp://itsm:itsm@<machine-ip>:5672/

# ── JWT ───────────────────────────────────────────────────────────────────────
# HS256 secret — replace with a strong random value in QA/prod.
JWT_SECRET=change-me-use-a-long-random-string
JWT_EXPIRY_HOURS=24

# ── Service ports (local dev / port-forward) ─────────────────────────────────
USER_SERVICE_PORT=8081
ASSET_SERVICE_PORT=8082
INCIDENT_SERVICE_PORT=8083
NOTIFICATION_SERVICE_PORT=8084

# ── OpenTelemetry ─────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=itsm-service        # overridden per-service in Helm values
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=dev

# ── AI (Phase 7 — leave blank until Phase 7) ─────────────────────────────────
AI_PROVIDER=                          # openai | ollama | azure-openai
AI_MODEL=
AI_API_KEY=
