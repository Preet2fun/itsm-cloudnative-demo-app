        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute > JSXIdentifier[name!=/^(?:text|size|gradientWords|key|ref|className|style|children)$/]",
        "message": "<Wordmark> doesn't accept that prop. Declared props: text, size, gradientWords."
      }
    ]
  },
