# services/frontend/Dockerfile
# Multi-stage build for Next.js 14 standalone output.
#
# Stages:
#   deps    — install all npm packages (includes devDeps for build)
#   builder — compile TypeScript + generate .next/standalone
#   runner  — minimal production image (~200 MB vs ~1 GB for full node_modules)
#
# The standalone output (next.config.ts: output: "standalone") copies only the
# packages actually imported at runtime into .next/standalone/node_modules.

# ── Stage 1: deps ─────────────────────────────────────────────────────────────
FROM node:20-alpine AS deps

# libc6-compat is needed for some native npm packages on Alpine
RUN apk add --no-cache libc6-compat

WORKDIR /app

# Copy manifests first for layer caching — reinstall only when these change
COPY package.json ./
RUN npm install --frozen-lockfile 2>/dev/null || npm install

# ── Stage 2: builder ──────────────────────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

# Bring in installed packages from deps stage
COPY --from=deps /app/node_modules ./node_modules

# Copy all source files
COPY . .

# Disable Next.js telemetry during build
ENV NEXT_TELEMETRY_DISABLED=1

# Build the production bundle (emits .next/standalone because output: "standalone")
RUN npm run build

# ── Stage 3: runner ───────────────────────────────────────────────────────────
FROM node:20-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# Cap JS heap to leave headroom within the 256Mi container memory limit
ENV NODE_OPTIONS="--max-old-space-size=200"

# Non-root user — UID 65532 matches other ITSM services
RUN addgroup --system --gid 65532 nonroot && \
    adduser --system --uid 65532 --ingroup nonroot nonroot

# Copy only what the standalone server needs at runtime
COPY --from=builder --chown=nonroot:nonroot /app/public ./public
COPY --from=builder --chown=nonroot:nonroot /app/.next/standalone ./
COPY --from=builder --chown=nonroot:nonroot /app/.next/static ./.next/static

USER 65532:65532

EXPOSE 3000

# .next/standalone/server.js is the production entry point generated by Next.js
CMD ["node", "server.js"]
